# Environment Variables — Teuly Connect Server
# Copy this file to .env and fill in actual values
# NEVER commit .env to version control

NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173

# MongoDB Atlas URI — provided separately before server start
MONGO_URI=

# JWT Secret — minimum 32 characters, generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=8h

# Nodemailer (Phase 3 — not needed for Phase 1)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASS=
